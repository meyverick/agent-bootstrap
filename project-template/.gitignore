# default-deny gitignore (AGENTS.md §12): block everything, allowlist work product.
*
!*/

# --- allowlist: the deliverables (root-anchored so negations don't leak
#     into excluded trees; macOS core.ignorecase makes loose patterns risky) ---
# NOTE: /agent-bootstrap is a tracked SUBMODULE (public repo) — deliberately
#       NOT ignored; its gitlink + .gitmodules must stay committable.
!/.gitignore
!.gitmodules
!/AGENTS.md
!/openspec/**
!/.agents/**
!/.antigravity/**
!/scripts/**

# --- .pi/: deny contents at any depth EXCEPT the env-refed project MCP and
#     the secret-free project LSP config ---
**/.pi/*
!/.pi/mcp.json
!/.pi/lsp.json

# --- re-deny local state & corpus LAST (last match wins: overrides any
#     accidental re-include above; keeps embedded-repo gitlinks out) ---
/references/
/graft/
/.qmd/
/.codegraph/
/.ignore
**/node_modules/
**/__pycache__/
**/.venv/
**/venv/
**/target/
**/dist/
**/.DS_Store
.DS_Store
*.log
*.sqlite

# --- excluded on purpose (never allowlisted above) ---
# references/  — vendored READ-ONLY upstream corpus (~609M, embedded .git
#                clones) — input material, re-clonable, keep out of VCS
# .qmd/ .codegraph/ graft/ — local caches (regenerable)
# .pi/ — local tool state; ONLY .pi/mcp.json (env-ref credentials) and .pi/lsp.json
#        (no secrets) are allowlisted — see agent-bootstrap/README.md
