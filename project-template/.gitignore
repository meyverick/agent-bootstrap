# default-deny gitignore (AGENTS.md §12): block everything, allowlist work product.
*
!*/

# --- allowlist: the deliverables (root-anchored so negations don't leak
#     into excluded trees; macOS core.ignorecase makes loose patterns risky) ---
# NOTE: /modules is a tracked SUBMODULE — deliberately NOT ignored;
#       its gitlink + .gitmodules must stay committable.
!/.gitignore
!.gitmodules
!/AGENTS.md
!/README.md
!/openspec/**
!/.agents/**
!/.antigravity/**
!/scripts/**
!/modules/**

# --- .pi/: deny contents at any depth EXCEPT the env-refed project MCP and
#     the secret-free project LSP config ---
**/.pi/*
!/.pi/mcp.json
!/.pi/lsp.json

# --- re-deny local state & corpus LAST (last match wins: overrides any
#     accidental re-include above; keeps embedded-repo gitlinks out) ---
/references/
/.codegraph/
/.ignore
**/node_modules/
**/__pycache__/
**/.venv/
**/venv/
**/target/
**/dist/
**/.DS_Store
.DS_Store
*.log
*.sqlite
