# default-deny (AGENTS.md §12): block everything, allowlist source product.
*
!*/

# --- allowlist: repository files & source ---
!.gitignore
!/README.md
!/CHANGELOG.md
!/package.json
!/bun.lockb
!/bun.lock
!/Cargo.toml
!/Cargo.lock
!/go.mod
!/go.sum
!/pyproject.toml
!/src/**
!/packages/**
!/scripts/**
!/tests/**

# --- re-exclude build artifacts and temp files ---
**/node_modules/
**/target/
**/dist/
**/build/
**/__pycache__/
**/.venv/
**/venv/
**/.DS_Store
.DS_Store
*.log
*.sqlite
